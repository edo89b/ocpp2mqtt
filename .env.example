# Copy this file to .env and fill in your values:
#   cp .env.example .env
# The .env file holds secrets and must NOT be committed.

# MQTT broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=ocpp2mqtt

# OCPP WebSocket port
OCPP_PORT=9000

# Known chargers: their "Disconnected" state is published (retained) on startup
# so the integration immediately shows the right state. Comma-separated list.
EXPECTED_CHARGERS=

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Static addresses on the macvlan network (adapt to your own network)
OCPP_IPV4=10.0.0.10
OCPP_IPV6=fd00::10
